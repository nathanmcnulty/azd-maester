{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "azd deployment validation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportType",
    "startedAt",
    "completedAt",
    "durationMs",
    "template",
    "mode",
    "requirements",
    "outcome",
    "summary",
    "checks",
    "nextSteps"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "reportType": {
      "const": "azdDeploymentValidation"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "template": {
      "$ref": "#/$defs/template"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "mode": {
      "enum": [
        "plan",
        "verify",
        "delivery"
      ]
    },
    "requirements": {
      "$ref": "#/$defs/requirements"
    },
    "outcome": {
      "enum": [
        "planned",
        "passed",
        "passedWithWarnings",
        "failed"
      ]
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "nextSteps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        },
        "subscriptionId": {
          "type": "string"
        },
        "resourceGroup": {
          "type": "string"
        },
        "azureCloud": {
          "type": "string"
        },
        "graphEnvironment": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "azdManagementEvidence": {
              "$ref": "#/$defs/azdManagementEvidence"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools",
        "modules",
        "permissions"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "fail",
        "warning",
        "info",
        "skipped",
        "planned"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "planned": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phase",
        "title",
        "status",
        "summary",
        "evidence",
        "durationMs",
        "sideEffect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]+$"
        },
        "phase": {
          "enum": [
            "context",
            "infrastructure",
            "identity",
            "configuration",
            "security",
            "runtime",
            "delivery"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "warning",
            "info",
            "skipped",
            "planned"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "object"
        },
        "remediation": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected": {},
        "actual": {},
        "metadata": {
          "type": "object"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "sideEffect": {
          "enum": [
            "none",
            "readOnly",
            "negativeProbe",
            "syntheticDelivery"
          ]
        }
      }
    },
    "azdManagementEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "evidenceClass",
        "binding",
        "nextActions"
      ],
      "properties": {
        "version": {
          "const": "1"
        },
        "evidenceClass": {
          "enum": [
            "validation",
            "delivery"
          ]
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project",
            "target",
            "source",
            "operation"
          ],
          "properties": {
            "project": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "environment"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\u0000-\\u001F]+$"
                },
                "environment": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\u0000-\\u001F]+$"
                }
              }
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "azureCloud",
                "tenantId",
                "subscriptionId"
              ],
              "properties": {
                "azureCloud": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\u0000-\\u001F]+$"
                },
                "tenantId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                },
                "subscriptionId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                },
                "resourceGroup": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\u0000-\\u001F]+$"
                }
              }
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "templateId",
                "revision"
              ],
              "properties": {
                "templateId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\u0000-\\u001F]+$"
                },
                "revision": {
                  "oneOf": [
                    {
                      "const": "local"
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    }
                  ]
                },
                "contractDigest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "operation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                },
                "kind": {
                  "enum": [
                    "provision",
                    "deploy",
                    "up",
                    "down",
                    "validate",
                    "delivery",
                    "cleanup"
                  ]
                }
              }
            }
          }
        },
        "nextActions": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "owner",
              "priority"
            ],
            "properties": {
              "code": {
                "enum": [
                  "reviewWarnings",
                  "retryOperation",
                  "verifyResources",
                  "verifyPermissions",
                  "proveDelivery",
                  "completeCleanup"
                ]
              },
              "owner": {
                "enum": [
                  "operator",
                  "subscriptionOwner",
                  "identityAdmin",
                  "messagingAdmin",
                  "applicationOwner",
                  "templateMaintainer"
                ]
              },
              "priority": {
                "enum": [
                  "required",
                  "recommended"
                ]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidenceClass": {
                "const": "delivery"
              }
            }
          },
          "then": {
            "properties": {
              "binding": {
                "properties": {
                  "operation": {
                    "properties": {
                      "kind": {
                        "enum": [
                          "delivery"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "binding": {
                "properties": {
                  "operation": {
                    "properties": {
                      "kind": {
                        "enum": [
                          "validate"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "1.1"
          }
        }
      },
      "then": {
        "required": [
          "environment"
        ],
        "properties": {
          "environment": {
            "required": [
              "metadata"
            ],
            "properties": {
              "metadata": {
                "required": [
                  "azdManagementEvidence"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "environment": {
            "properties": {
              "metadata": {
                "not": {
                  "required": [
                    "azdManagementEvidence"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "schemaVersion",
          "mode"
        ],
        "properties": {
          "schemaVersion": {
            "const": "1.1"
          },
          "mode": {
            "const": "delivery"
          }
        }
      },
      "then": {
        "properties": {
          "environment": {
            "properties": {
              "metadata": {
                "properties": {
                  "azdManagementEvidence": {
                    "properties": {
                      "evidenceClass": {
                        "const": "delivery"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "schemaVersion": {
              "const": "1.1"
            }
          }
        },
        "then": {
          "properties": {
            "environment": {
              "properties": {
                "metadata": {
                  "properties": {
                    "azdManagementEvidence": {
                      "properties": {
                        "evidenceClass": {
                          "const": "validation"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
